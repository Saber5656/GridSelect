{
  "schemaVersion": 1,
  "id": "keyboard-key-repeat",
  "description": "Repeated key events move one boundary per event in both horizontal and vertical dimensions.",
  "covers": [
    "key-repeat"
  ],
  "start": {
    "method": "keyboard",
    "anchor": {
      "row": 1,
      "column": 5
    }
  },
  "expectedInitial": {
    "phase": "adjusting",
    "anchor": {
      "row": 1,
      "column": 5
    },
    "focus": {
      "row": 1,
      "column": 5
    },
    "rowRange": {
      "start": 1,
      "end": 2
    },
    "columnRange": {
      "start": 5,
      "end": 5
    },
    "isEmpty": true
  },
  "steps": [
    {
      "action": "keyboard-move",
      "direction": "right",
      "repeat": 4,
      "expected": {
        "phase": "adjusting",
        "anchor": {
          "row": 1,
          "column": 5
        },
        "focus": {
          "row": 1,
          "column": 9
        },
        "rowRange": {
          "start": 1,
          "end": 2
        },
        "columnRange": {
          "start": 5,
          "end": 9
        },
        "isEmpty": false
      }
    },
    {
      "action": "keyboard-move",
      "direction": "down",
      "repeat": 2,
      "expected": {
        "phase": "adjusting",
        "anchor": {
          "row": 1,
          "column": 5
        },
        "focus": {
          "row": 3,
          "column": 9
        },
        "rowRange": {
          "start": 1,
          "end": 4
        },
        "columnRange": {
          "start": 5,
          "end": 9
        },
        "isEmpty": false
      }
    }
  ]
}
